# Supabase — from Project Settings → API
# Copy this file to `.env.local` and fill in the values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by scripts/ingest-medmcqa.ts to bypass RLS on insert.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Path to a MedMCQA JSONL file (see supabase/README.md for how to obtain it).
MEDMCQA_FILE=./scripts/data/medmcqa-train.jsonl
